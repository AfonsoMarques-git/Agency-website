# =============================================================
# WEMOV Agency — Environment configuration
# Copy this file to ".env" and replace ALL placeholder values
# before running the server in production.
# =============================================================

# Network ---------------------------------------------------
PORT=3000
HOST=0.0.0.0

# Runtime ---------------------------------------------------
# Use "production" once deployed; "development" only locally.
NODE_ENV=development

# Public origin (used for CORS + cookies in production).
# Example: https://www.wemovagency.com
PUBLIC_ORIGIN=http://localhost:3000

# Authentication --------------------------------------------
# A long, random secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret-string-please

# How long an admin session stays valid (e.g. 8h, 30m, 7d)
JWT_EXPIRES_IN=8h

# Cookie used for the admin JWT
SESSION_COOKIE_NAME=wemov_admin

# Optional one-time setup key (used only if you ever need to
# bootstrap a new admin user from the CLI / reset flow).
ADMIN_SETUP_KEY=replace-me-too

# Default admin (only used during first seed) ---------------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=WeMov2026!

# Uploads ---------------------------------------------------
# 8 MB per file
UPLOAD_MAX_BYTES=8388608
